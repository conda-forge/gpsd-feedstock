From c29730f9844fc75a1e481b641e4f4e8000ad4611 Mon Sep 17 00:00:00 2001
From: Wolf Vollprecht <w.vollprecht@gmail.com>
Date: Thu, 12 Nov 2026 08:00:18 +0100
Subject: [PATCH] Adapt build checks to the conda toolchain

Retain conda compiler flag and Linux PPS workarounds. Link libudev only on Linux, not macOS. Python installation paths are now set via the supported python_libdir option.
---
 SConscript         | 8 ++++----
 clients/ppscheck.c | 2 +-
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/SConscript b/SConscript
index 794463a..76b8ed5 100644
--- a/SConscript
+++ b/SConscript
@@ -828,8 +828,7 @@ def CheckCompilerOption(context, option):
     old_CFLAGS = context.env['CFLAGS'][:]  # Get a *copy* of the old list
     context.env.Append(CFLAGS=option)
     new_CFLAGS = context.env['CFLAGS'][:]  # Get a *copy* of the old list
-    # we don't want to use options that generate warnings.
-    context.env.Append(CFLAGS="-Werror")
+    # Conda's toolchain can warn about unused flags during feature checks.
     ret = context.TryLink("""
         int main(int argc, char **argv) {
             (void) argc; (void) argv;
@@ -960,8 +959,7 @@ if not cleaning and not helping:
     if not config.CheckCC():
         announce("ERROR: CC doesn't work")
 
-    if ((config.CheckCompilerOption("-pthread") and
-         not config.env['target_platform'].startswith('darwin'))):
+    if not config.env['target_platform'].startswith('darwin'):
         config.env.MergeFlags("-pthread")
 
     if config.env['target_platform'].startswith('openbsd7'):
@@ -1158,6 +1156,8 @@ if not cleaning and not helping:
             confdefs.append("#define HAVE_LIBUSB 1\n")
             try:
                 usbflags = pkg_config('libusb-1.0')
+                if config.env['target_platform'].startswith('linux'):
+                    usbflags.append(["-ludev"])
             except OSError:
                 announce("pkg_config is confused about the state "
                          "of libusb-1.0.")
diff --git a/clients/ppscheck.c b/clients/ppscheck.c
index 7cdfe25..9164892 100644
--- a/clients/ppscheck.c
+++ b/clients/ppscheck.c
@@ -602,7 +602,7 @@ int main(int argc, char *argv[])
          * if (0 == ioctl(device_fd, TIOCGETD, &ldisc)) {
          * always returns ldisc == 0 */
         // set PPS line discipline
-        ldisc = N_PPS;    // 18 - the PPS line discipline
+        ldisc = 18;    // 18 - the PPS line discipline
         if (0 > ioctl(device_fd, TIOCSETD, &ldisc)) {
             (void)printf("ERROR: ioctl(%s, TIOCSETD, 18) failed: %.80s(%d)\n",
                          argv[1], strerror(errno), errno);
-- 
2.56.0

